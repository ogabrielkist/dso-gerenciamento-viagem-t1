@startuml
' Skinparam melhora a aparência do diagrama
skinparam classAttributeIconSize 0
skinparam defaultFontName "Segoe UI"
skinparam roundcorner 10
hide empty members

package "Controller" <<Frame>> {
  abstract class ControladorBase {
    # __controlador_principal: ControladorPrincipal
    # _entidades: list
    # _tela: TelaBase
    # _mapa_opcoes: dict
    --
    + incluir(): void
    + listar(): void
    + excluir(): void
    + editar(): void
    + retornar(): void
    + abre_tela(): void
    # {abstract} _criar_entidade(dados): Entity
    # {abstract} _atualizar_entidade(entidade, dados): void
    # {abstract} _entidade_para_dict(entidade): dict
    # {abstract} _obter_identificador(entidade): str
  }

  class ControladorPrincipal {
    - __ctrl_pessoa: ControladorPessoa
    - __ctrl_pais: ControladorPais
    - __ctrl_cidade: ControladorCidade
    - __ctrl_empresa: ControladorEmpresaTransporte
    - __ctrl_meio_transporte: ControladorMeioTransporte
    - __ctrl_viagem: ControladorViagem
    - __ctrl_trecho: ControladorTrechoViagem
    - __ctrl_passeio: ControladorPasseioTuristico
    - __ctrl_passagem: ControladorPassagem
    - __ctrl_pagamento: ControladorPagamento
    - __ctrl_itinerario: ControladorItinerarioViagem
    --
    + inicia_sistema(): void
    + cadastra_pessoa(): void
    + cadastra_pais(): void
    + cadastra_cidade(): void
    + cadastra_empresa_transporte(): void
    + cadastra_meio_transporte(): void
    + cadastra_viagem(): void
    + cadastra_trecho_viagem(): void
    + cadastra_passeio_turistico(): void
    + cadastra_passagem(): void
    + cadastra_pagamento(): void
    + cadastra_itinerario_viagem(): void
    + relatorios(): void
    + encerra_sistema(): void
    + abre_tela(): void
  }

  class ControladorPessoa {
    - _dao: DAOPessoa
    --
    + _criar_entidade(dados): Pessoa
    + _atualizar_entidade(pessoa, dados): void
    + _entidade_para_dict(pessoa): dict
    + _obter_identificador(pessoa): str
  }

  class ControladorPais {
    - _dao: DAOPais
    --
    + _criar_entidade(dados): Pais
    + _atualizar_entidade(pais, dados): void
    + _entidade_para_dict(pais): dict
    + _obter_identificador(pais): str
  }

  class ControladorCidade {
    - _dao: DAOCidade
    --
    + _criar_entidade(dados): Cidade
    + _atualizar_entidade(cidade, dados): void
    + _entidade_para_dict(cidade): dict
    + _obter_identificador(cidade): str
  }

  class ControladorEmpresaTransporte {
    - _dao: DAOEmpresaTransporte
    --
    + _criar_entidade(dados): EmpresaTransporte
    + _atualizar_entidade(empresa, dados): void
    + _entidade_para_dict(empresa): dict
    + _obter_identificador(empresa): str
  }

  class ControladorMeioTransporte {
    - _dao: DAOMeioTransporte
    --
    + _criar_entidade(dados): MeioTransporte
    + _atualizar_entidade(meio, dados): void
    + _entidade_para_dict(meio): dict
    + _obter_identificador(meio): str
  }

  class ControladorViagem {
    - _dao: DAOViagem
    --
    + _criar_entidade(dados): Viagem
    + _atualizar_entidade(viagem, dados): void
    + _entidade_para_dict(viagem): dict
    + _obter_identificador(viagem): str
  }

  class ControladorTrechoViagem {
    - _dao: DAOTrechoViagem
    --
    + _criar_entidade(dados): TrechoViagem
    + _atualizar_entidade(trecho, dados): void
    + _entidade_para_dict(trecho): dict
  }

  class ControladorPasseioTuristico {
    - _dao: DAOPasseioTuristico
    --
    + _criar_entidade(dados): PasseioTuristico
    + _atualizar_entidade(passeio, dados): void
    + _entidade_para_dict(passeio): dict
  }

  class ControladorPassagem {
    - _dao: DAOPassagem
    --
    + _criar_entidade(dados): Passagem
    + _atualizar_entidade(passagem, dados): void
    + _entidade_para_dict(passagem): dict
    + confirmar_compra(): void
  }

  class ControladorPagamento {
    - _dao: DAOPagamento
    --
    + _criar_entidade(dados): Pagamento
    + _atualizar_entidade(pagamento, dados): void
    + _entidade_para_dict(pagamento): dict
  }

  class ControladorItinerarioViagem {
    - _dao: DAOItinerarioViagem
    --
    + _criar_entidade(dados): ItinerarioViagem
    + _atualizar_entidade(itinerario, dados): void
    + _entidade_para_dict(itinerario): dict
    + gerenciar_passeios(): void
  }
}

package "View" <<Frame>> {
  abstract class TelaBase {
    --
    + limpar_tela(): void
    + aguardar_enter(): void
    + mostra_mensagem(msg: str, aguardar: bool): void
    + mostra_erro(msg: str): void
    + mostra_sucesso(msg: str): void
    + tela_opcoes(titulo: str, opcoes: dict): void
    + {abstract} le_opcao(): int
  }

  class TelaPessoa {
    --
    + le_opcao(): int
    + pega_dados_entidade(): dict
    + mostra_entidade(dados: dict): void
    + seleciona_entidade(): str
  }

  class TelaPais {
    --
    + le_opcao(): int
    + pega_dados_entidade(): dict
    + mostra_entidade(dados: dict): void
    + seleciona_entidade(): str
  }

  class TelaCidade {
    - _controlador_pais: ControladorPais
    --
    + set_controlador_pais(controlador): void
    + le_opcao(): int
    + pega_dados_entidade(): dict
    + mostra_entidade(dados: dict): void
    + seleciona_entidade(): str
  }

  class TelaEmpresaTransporte {
    --
    + le_opcao(): int
    + pega_dados_entidade(): dict
    + mostra_entidade(dados: dict): void
    + seleciona_entidade(): str
  }

  class TelaMeioTransporte {
    - _controlador_empresa: ControladorEmpresaTransporte
    --
    + set_controlador_empresa(controlador): void
    + le_opcao(): int
    + pega_dados_entidade(): dict
    + mostra_entidade(dados: dict): void
    + seleciona_entidade(): str
  }

  class TelaViagem {
    --
    + le_opcao(): int
    + pega_dados_entidade(): dict
    + mostra_entidade(dados: dict): void
    + seleciona_entidade(): str
  }

  class TelaTrechoViagem {
    - _controlador_meio_transporte: ControladorMeioTransporte
    --
    + set_controlador_meio_transporte(controlador): void
    + le_opcao(): int
    + pega_dados_entidade(): dict
    + mostra_entidade(dados: dict): void
    + seleciona_entidade(): str
  }

  class TelaPasseioTuristico {
    - _controlador_cidade: ControladorCidade
    - _controlador_pessoa: ControladorPessoa
    --
    + set_controlador_cidade(controlador): void
    + set_controlador_pessoa(controlador): void
    + le_opcao(): int
    + pega_dados_entidade(): dict
    + mostra_entidade(dados: dict): void
    + seleciona_entidade(): str
  }

  class TelaPassagem {
    - _controlador_pessoa: ControladorPessoa
    - _controlador_trecho: ControladorTrechoViagem
    --
    + set_controlador_pessoa(controlador): void
    + set_controlador_trecho(controlador): void
    + le_opcao(): int
    + pega_dados_entidade(): dict
    + mostra_entidade(dados: dict): void
    + seleciona_entidade(): str
  }

  class TelaPagamento {
    - _controlador_pessoa: ControladorPessoa
    - _controlador_viagem: ControladorViagem
    --
    + set_controlador_pessoa(controlador): void
    + set_controlador_viagem(controlador): void
    + le_opcao(): int
    + pega_dados_entidade(): dict
    + mostra_entidade(dados: dict): void
    + seleciona_entidade(): str
  }

  class TelaItinerarioViagem {
    - _controlador_viagem: ControladorViagem
    - _controlador_passeio: ControladorPasseioTuristico
    --
    + set_controlador_viagem(controlador): void
    + set_controlador_passeio(controlador): void
    + le_opcao(): int
    + pega_dados_entidade(): dict
    + mostra_entidade(dados: dict): void
    + seleciona_entidade(): str
    + gerenciar_passeios(itinerario): void
    + adicionar_passeio(itinerario): void
    + remover_passeio(itinerario): void
    + listar_passeios(itinerario): void
  }
}


package "DAO" <<Frame>> {
  abstract class DAOBase {
    - __arquivo: str
    --
    + carregar(): list[Entity]
    + salvar(entidades: list[Entity]): void
    + {abstract} _serializar_entidade(entidade): dict
    + {abstract} _deserializar_entidade(dados): Entity
  }

  class DAOPessoa {
    --
    + _serializar_entidade(pessoa): dict
    + _deserializar_entidade(dados): Pessoa
  }

  class DAOPais {
    --
    + _serializar_entidade(pais): dict
    + _deserializar_entidade(dados): Pais
  }

  class DAOCidade {
    --
    + _serializar_entidade(cidade): dict
    + _deserializar_entidade(dados): Cidade
  }

  class DAOEmpresaTransporte {
    --
    + _serializar_entidade(empresa): dict
    + _deserializar_entidade(dados): EmpresaTransporte
  }

  class DAOMeioTransporte {
    --
    + _serializar_entidade(meio): dict
    + _deserializar_entidade(dados): MeioTransporte
  }

  class DAOViagem {
    --
    + _serializar_entidade(viagem): dict
    + _deserializar_entidade(dados): Viagem
  }

  class DAOTrechoViagem {
    --
    + _serializar_entidade(trecho): dict
    + _deserializar_entidade(dados): TrechoViagem
  }

  class DAOPasseioTuristico {
    --
    + _serializar_entidade(passeio): dict
    + _deserializar_entidade(dados): PasseioTuristico
  }

  class DAOPassagem {
    --
    + _serializar_entidade(passagem): dict
    + _deserializar_entidade(dados): Passagem
  }

  class DAOPagamento {
    --
    + _serializar_entidade(pagamento): dict
    + _deserializar_entidade(dados): Pagamento
  }

  class DAOItinerarioViagem {
    --
    + _serializar_entidade(itinerario): dict
    + _deserializar_entidade(dados): ItinerarioViagem
  }
}

package "Model" <<Frame>> {

  ' --- Definição das Classes Base (Cadastros) ---

  class Pessoa {
    - nome: str
    - celular: str
    - identificacao: str
    - idade: int
    --
    + __init__(nome: str, celular: str, identificacao: str, idade: int)
    + get_nome(): str
    + set_nome(nome: str): void
    + get_celular(): str
    + set_celular(celular: str): void
    + get_identificacao(): str
    + set_identificacao(identificacao: str): void
    + get_idade(): int
    + set_idade(idade: int): void
    + pode_participar_viagem(): bool
  }

  class Pais {
    - nome: str
    - cidades: list[Cidade]
    --
    + __init__(nome: str)
    + get_nome(): str
    + set_nome(nome: str): void
    + incluir_cidade(cidade: Cidade): void
    + excluir_cidade(cidade: Cidade): void
  }

  class Cidade {
    - nome: str
    - pais: Pais
    --
    + __init__(nome: str, pais: Pais)
    + get_nome(): str
    + set_nome(nome: str): void
    + get_pais(): Pais
    + set_pais(pais: Pais): void
  }

  class EmpresaTransporte {
    - nome: str
    - cnpj: str
    - telefone: str
    --
    + __init__(nome, cnpj, telefone)
    + get_nome(): str
    + set_nome(nome: str): void
    + get_cnpj(): str
    + set_cnpj(cnpj: str): void
    + get_telefone(): str
    + set_telefone(telefone: str): void
  }

  ' Enum para os tipos de transporte
  enum TipoTransporte {
    AVIAO
    CARRO
    TREM
    ONIBUS
  }

  class MeioTransporte {
    - tipo: TipoTransporte
    - empresa: EmpresaTransporte
    --
    + __init__(tipo: TipoTransporte, empresa: EmpresaTransporte)
    + get_tipo(): TipoTransporte
    + set_tipo(tipo: TipoTransporte): void
    + get_empresa(): EmpresaTransporte
    + set_empresa(empresa: EmpresaTransporte): void
  }


  ' --- Definição da Classe Central (Viagem) e suas Partes ---

  class Viagem {
    - data_inicio: date
    - data_fim: date
    - valor_total_pacote: float
    - participantes: list[Pessoa]
    - destinos_visitados: list[Cidade]
    - itinerarios: list[ItinerarioViagem]
    - trechos: list[TrechoViagem]
    - pagamentos_recebidos: list[Pagamento]
    - passagens_compradas: list[Passagem]
    --
    + __init__(inicio, fim, valor_total)
    + get_data_inicio(): date
    + set_data_inicio(data: date): void
    + get_data_fim(): date
    + set_data_fim(data: date): void
    + get_valor_total_pacote(): float
    + set_valor_total_pacote(valor: float): void
    --
    + incluir_participante(p: Pessoa): void
    + excluir_participante(p: Pessoa): void
    + incluir_destino(c: Cidade): void
    + excluir_destino(c: Cidade): void
    + incluir_itinerario(i: ItinerarioViagem): void
    + excluir_itinerario(i: ItinerarioViagem): void
    + incluir_trecho(t: TrechoViagem): void
    + excluir_trecho(t: TrechoViagem): void
    + incluir_pagamento(p: Pagamento): void
    + excluir_pagamento(p: Pagamento): void
    + incluir_passagem(p: Passagem): void
    + excluir_passagem(p: Passagem): void
    --
    + get_valor_total_pago(): float
    + get_valor_restante(): float
    + get_valor_pago_por_pessoa(pessoa: Pessoa): float
    + get_valor_restante_por_pessoa(pessoa: Pessoa): float
    + get_pessoas_com_pagamento_completo(): list[Pessoa]
    + get_pessoas_com_pagamento_pendente(): list[Pessoa]
    + pode_iniciar_viagem(): bool
    + validar_viagem(): bool
  }

  class ItinerarioViagem {
    - data: date
    - passeios: list[PasseioTuristico]
    --
    + __init__(data: date)
    + get_data(): date
    + set_data(data: date): void
    + incluir_passeio(p: PasseioTuristico): void
    + excluir_passeio(p: PasseioTuristico): void
  }

  class PasseioTuristico {
    - atracao_turistica: str
    - horario_inicio: time
    - horario_fim: time
    - valor: float
    - cidade: Cidade
    - participantes_passeio: list[Pessoa]
    --
    + __init__(atracao: str, inicio: time, fim: time, valor: float, cidade: Cidade)
    + get_atracao_turistica(): str
    + set_atracao_turistica(atracao: str): void
    + get_horario_inicio(): time
    + set_horario_inicio(inicio: time): void
    + get_horario_fim(): time
    + set_horario_fim(fim: time): void
    + get_valor(): float
    + set_valor(valor: float): void
    + get_cidade(): Cidade
    + set_cidade(cidade: Cidade): void
    + incluir_participante(p: Pessoa): void
    + excluir_participante(p: Pessoa): void
  }

  class TrechoViagem {
    - data: datetime
    - local_origem: str
    - local_destino: str
    - meio_transporte: MeioTransporte
    --
    + __init__(data: datetime, origem: str, destino: str, transporte: MeioTransporte)
    + get_data(): datetime
    + set_data(data: datetime): void
    + get_local_origem(): str
    + set_local_origem(origem: str): void
    + get_local_destino(): str
    + set_local_destino(destino: str): void
    + get_meio_transporte(): MeioTransporte
    + set_meio_transporte(m: MeioTransporte): void
  }

  ' --- Classe de Associação (Passagem) ---

  class Passagem {
    - compra_efetuada: bool
    - passageiro: Pessoa
    - trecho: TrechoViagem
    - responsavel_compra: Pessoa
    --
    + __init__(passageiro: Pessoa, trecho: TrechoViagem, responsavel: Pessoa)
    + is_compra_efetuada(): bool
    + set_compra_efetuada(status: bool): void
    + get_passageiro(): Pessoa
    + set_passageiro(p: Pessoa): void
    + get_trecho(): TrechoViagem
    + set_trecho(t: TrechoViagem): void
    + get_responsavel_compra(): Pessoa
    + set_responsavel_compra(p: Pessoa): void
  }


  ' --- Definição da Hierarquia de Pagamentos (Herança) ---

  abstract class Pagamento {
    - data: date
    - valor_pago: float
    - pagador: Pessoa
    - viagem: Viagem
    --
    + __init__(data: date, valor: float, pagador: Pessoa, viagem: Viagem)
    + get_data(): date
    + set_data(data: date): void
    + get_valor_pago(): float
    + set_valor_pago(valor: float): void
    + get_pagador(): Pessoa
    + set_pagador(p: Pessoa): void
    + get_viagem(): Viagem
    + set_viagem(v: Viagem): void
  }

  class PagamentoDinheiro {
    + __init__(data: date, valor: float, pagador: Pessoa, viagem: Viagem)
  }

  class PagamentoPix {
    - cpf_pagador: str
    --
    + __init__(data: date, valor: float, pagador: Pessoa, viagem: Viagem, cpf: str)
    + get_cpf_pagador(): str
    + set_cpf_pagador(cpf: str): void
  }

  class PagamentoCartao {
    - numero_cartao: str
    - bandeira: str
    --
    + __init__(data: date, valor: float, pagador: Pessoa, viagem: Viagem, numero: str, bandeira: str)
    + get_numero_cartao(): str
    + set_numero_cartao(numero: str): void
    + get_bandeira(): str
    + set_bandeira(bandeira: str): void
  }

  ' --- RELACIONAMENTOS DO MODELO ---

  ' Herança
  Pagamento <|-- PagamentoDinheiro
  Pagamento <|-- PagamentoPix
  Pagamento <|-- PagamentoCartao

  ' Agregações e Composições
  Viagem o-- "1..*" Pessoa : - participantes
  Viagem *-- "1..*" ItinerarioViagem : - itinerarios
  Viagem *-- "1..*" TrechoViagem : - trechos
  Viagem o-- "0..*" Pagamento : - pagamentos_recebidos
  Viagem o-- "0..*" Passagem : - passagens_compradas
  ItinerarioViagem *-- "0..*" PasseioTuristico : - passeios
  Pais *-- "1..*" Cidade : - cidades

  ' Associações
  Pagamento --> "1" Pessoa : - pagador
  Pagamento --> "1" Viagem : - viagem
  Viagem ..> "1..*" Cidade : - destinos_visitados
  PasseioTuristico --> "1" Cidade : - cidade
  MeioTransporte --> "1" EmpresaTransporte : - empresa
  TrechoViagem --> "1" MeioTransporte : - meio_transporte
  PasseioTuristico ..> "1..*" Pessoa : - participantes_passeio
  Passagem --> "1" Pessoa : - passageiro
  Passagem --> "1" TrechoViagem : - trecho
  Passagem --> "1" Pessoa : - responsavel_compra
}

' Herança - Base Classes
ControladorBase <|-- ControladorPessoa
ControladorBase <|-- ControladorPais
ControladorBase <|-- ControladorCidade
ControladorBase <|-- ControladorEmpresaTransporte
ControladorBase <|-- ControladorMeioTransporte
ControladorBase <|-- ControladorViagem

TelaBase <|-- TelaPessoa
TelaBase <|-- TelaPais
TelaBase <|-- TelaCidade
TelaBase <|-- TelaEmpresaTransporte
TelaBase <|-- TelaMeioTransporte
TelaBase <|-- TelaViagem

DAOBase <|-- DAOPessoa
DAOBase <|-- DAOPais
DAOBase <|-- DAOCidade
DAOBase <|-- DAOEmpresaTransporte
DAOBase <|-- DAOMeioTransporte
DAOBase <|-- DAOViagem

' O Controlador Principal instancia e gerencia os outros controladores
ControladorPrincipal *-- "1" ControladorPessoa
ControladorPrincipal *-- "1" ControladorPais
ControladorPrincipal *-- "1" ControladorCidade
ControladorPrincipal *-- "1" ControladorEmpresaTransporte
ControladorPrincipal *-- "1" ControladorMeioTransporte
ControladorPrincipal *-- "1" ControladorViagem
ControladorPrincipal *-- "1" ControladorTrechoViagem
ControladorPrincipal *-- "1" ControladorPasseioTuristico
ControladorPrincipal *-- "1" ControladorPassagem
ControladorPrincipal *-- "1" ControladorPagamento
ControladorPrincipal *-- "1" ControladorItinerarioViagem

' Controllers usam suas respectivas Views
ControladorPessoa *-- "1" TelaPessoa
ControladorPais *-- "1" TelaPais
ControladorCidade *-- "1" TelaCidade
ControladorEmpresaTransporte *-- "1" TelaEmpresaTransporte
ControladorMeioTransporte *-- "1" TelaMeioTransporte
ControladorViagem *-- "1" TelaViagem
ControladorTrechoViagem *-- "1" TelaTrechoViagem
ControladorPasseioTuristico *-- "1" TelaPasseioTuristico
ControladorPassagem *-- "1" TelaPassagem
ControladorPagamento *-- "1" TelaPagamento
ControladorItinerarioViagem *-- "1" TelaItinerarioViagem

' Controllers usam seus respectivos DAOs
ControladorPessoa *-- "1" DAOPessoa
ControladorPais *-- "1" DAOPais
ControladorCidade *-- "1" DAOCidade
ControladorEmpresaTransporte *-- "1" DAOEmpresaTransporte
ControladorMeioTransporte *-- "1" DAOMeioTransporte
ControladorViagem *-- "1" DAOViagem
ControladorTrechoViagem *-- "1" DAOTrechoViagem
ControladorPasseioTuristico *-- "1" DAOPasseioTuristico
ControladorPassagem *-- "1" DAOPassagem
ControladorPagamento *-- "1" DAOPagamento
ControladorItinerarioViagem *-- "1" DAOItinerarioViagem

' Dependências entre Controllers
ControladorCidade ..> ControladorPais : usa
ControladorMeioTransporte ..> ControladorEmpresaTransporte : usa
ControladorTrechoViagem ..> ControladorMeioTransporte : usa
ControladorPasseioTuristico ..> ControladorCidade : usa
ControladorPasseioTuristico ..> ControladorPessoa : usa
ControladorPassagem ..> ControladorPessoa : usa
ControladorPassagem ..> ControladorTrechoViagem : usa
ControladorPagamento ..> ControladorPessoa : usa
ControladorPagamento ..> ControladorViagem : usa
ControladorItinerarioViagem ..> ControladorViagem : usa
ControladorItinerarioViagem ..> ControladorPasseioTuristico : usa

' Dependências entre Views e Controllers
TelaCidade ..> ControladorPais : usa
TelaMeioTransporte ..> ControladorEmpresaTransporte : usa
TelaTrechoViagem ..> ControladorMeioTransporte : usa
TelaPasseioTuristico ..> ControladorCidade : usa
TelaPasseioTuristico ..> ControladorPessoa : usa
TelaPassagem ..> ControladorPessoa : usa
TelaPassagem ..> ControladorTrechoViagem : usa
TelaPagamento ..> ControladorPessoa : usa
TelaPagamento ..> ControladorViagem : usa
TelaItinerarioViagem ..> ControladorViagem : usa
TelaItinerarioViagem ..> ControladorPasseioTuristico : usa

' DAOs gerenciam as entidades
DAOPessoa o-- "0..*" Pessoa
DAOPais o-- "0..*" Pais
DAOCidade o-- "0..*" Cidade
DAOEmpresaTransporte o-- "0..*" EmpresaTransporte
DAOMeioTransporte o-- "0..*" MeioTransporte
DAOViagem o-- "0..*" Viagem
DAOTrechoViagem o-- "0..*" TrechoViagem
DAOPasseioTuristico o-- "0..*" PasseioTuristico
DAOPassagem o-- "0..*" Passagem
DAOPagamento o-- "0..*" Pagamento
DAOItinerarioViagem o-- "0..*" ItinerarioViagem

@enduml
